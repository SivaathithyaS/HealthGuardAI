# ─────────────────────────────────────────────────────────────────────────────
# HealthGuard AI — Environment Configuration
# Copy this file to .env and fill in your credentials
# ─────────────────────────────────────────────────────────────────────────────

# ── SMTP Email (for real OTP emails) ─────────────────────────────────────────
# Use a Gmail account with 2FA enabled and an App Password
# Guide: https://support.google.com/accounts/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=unbanpubg12345@gmail.com
SMTP_PASSWORD=wkmu mbgz zpdv vymn
SMTP_FROM_NAME=HealthGuard AI Security

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path is auto-resolved. Override only if needed.
# DB_PATH=backend/data/healthguard.db

# ── Groq LLM Narration ───────────────────────────────────────────────────────
# Get your free API key at https://console.groq.com/
# Used for natural-language narration of visit-over-visit comparisons.
# If not set, the system falls back to a deterministic template narrator.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_NARRATION_ENABLED=true

